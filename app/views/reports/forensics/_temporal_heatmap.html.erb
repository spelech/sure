<%# locals: (heatmap_data:) %>
<div class="space-y-5" data-controller="forensics--heatmap">
  <script type="application/json" data-forensics--heatmap-target="dataStore">
    <%= heatmap_data.to_json.html_safe %>
  </script>

  <!-- Floating Tooltip -->
  <div data-forensics--heatmap-target="tooltip" class="fixed hidden z-50 pointer-events-none bg-surface-inset/95 backdrop-blur-sm border border-primary/40 rounded-lg p-2.5 text-xs shadow-xl min-w-[160px] transition-opacity"></div>

  <!-- Header & Merchant Filter -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h3 class="text-sm font-medium text-primary uppercase tracking-wider"><%= t("reports.forensics.heatmap.title", default: "Temporal Spending Heatmap") %></h3>
      <p class="text-xs text-secondary"><%= t("reports.forensics.heatmap.subtitle", default: "365-day calendar matrix displaying daily outflow frequency and spending intensity") %></p>
    </div>

    <div class="flex items-center gap-2">
      <label for="heatmap-merchant-filter" class="text-xs font-medium text-secondary whitespace-nowrap"><%= t("reports.forensics.heatmap.filter_merchant", default: "Merchant:") %></label>
      <select
        id="heatmap-merchant-filter"
        data-forensics--heatmap-target="merchantSelect"
        data-action="change->forensics--heatmap#filterMerchant"
        class="text-xs bg-surface-inset border border-primary text-primary rounded-lg px-3 py-1.5 focus:ring-1 focus:ring-primary focus:outline-none cursor-pointer max-w-[240px] truncate"
      >
        <option value="all"><%= t("reports.forensics.heatmap.all_merchants", default: "All Outflows (Consolidated)") %></option>
      </select>
    </div>
  </div>

  <!-- Summary KPI Stats -->
  <div data-forensics--heatmap-target="summaryStats"></div>

  <!-- 365-Day Calendar Grid Container -->
  <div class="rounded-xl border border-primary bg-container p-4 overflow-x-auto custom-scrollbar">
    <div data-forensics--heatmap-target="grid"></div>

    <!-- Legend Footer -->
    <div class="mt-4 pt-3 border-t border-primary/20 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-secondary">
      <div class="flex items-center gap-1.5">
        <span class="text-[10px] uppercase tracking-wider font-semibold text-secondary mr-1"><%= t("reports.forensics.heatmap.intensity", default: "Spend Intensity:") %></span>
        <span class="text-[10px] text-secondary">Less</span>
        <div class="w-3 h-3 rounded-[2px] bg-surface-inset opacity-40 border border-primary/10" title="$0"></div>
        <div class="w-3 h-3 rounded-[2px] bg-emerald-950/70 border border-emerald-800/40 text-emerald-300" title="<$25"></div>
        <div class="w-3 h-3 rounded-[2px] bg-emerald-700/80 border border-emerald-600/50 text-emerald-100" title="<$75"></div>
        <div class="w-3 h-3 rounded-[2px] bg-emerald-500 border border-emerald-400 text-white" title="<$200"></div>
        <div class="w-3 h-3 rounded-[2px] bg-purple-600 border border-purple-400 text-white shadow-[0_0_8px_rgba(168,85,247,0.4)]" title="≥$200"></div>
        <span class="text-[10px] text-secondary ml-1">More</span>
      </div>
      <div class="text-[10px] text-secondary">
        <span><%= t("reports.forensics.heatmap.legend_note", default: "* Squares represent aggregate daily outflow across 53 calendar weeks") %></span>
      </div>
    </div>
  </div>
</div>
